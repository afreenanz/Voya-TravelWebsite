# Copy to .env for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key
# Free models (":free") cost nothing but are rate-limited. Create the key with "No expiration".
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: comma-separated backups OpenRouter tries when the main model is busy (max 2).
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free

# Geoapify → https://myprojects.geoapify.com (free tier; not used yet, reserved for the upcoming places search)
GEOAPIFY_API_KEY=your-geoapify-key

# Long random string used to sign session tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me

# Public base URL of the app (used for the Google OAuth redirect).
# Local: http://localhost:5001   Production: https://voya-travel-website-eta.vercel.app
APP_BASE_URL=http://localhost:5001
