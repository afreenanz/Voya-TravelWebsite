# Copy to .env for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Long random string used to sign session tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me

# Public base URL of the app (used for the Google OAuth redirect).
# Local: http://localhost:5001   Production: https://voya-travel-website-eta.vercel.app
APP_BASE_URL=http://localhost:5001
